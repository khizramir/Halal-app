# Neon Postgres connection string (from your Neon project dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js — generate with: openssl rand -hex 32
AUTH_SECRET=

# Google OAuth (console.cloud.google.com)
# Redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (resend.com) — used for email sign-in links
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Halo <onboarding@resend.dev>"

# Express API server port
PORT=3001

# Anthropic API key — used for AI ingredient-photo analysis (/api/analyse-ingredients,
# /api/scan/photo), the smart basket builder (/api/shop/basket) and the AI meal
# planner (/api/meal-plan)
ANTHROPIC_API_KEY=

# Reserved for future integrations — not yet wired up. The app runs fine without
# these; features that depend on them will be skipped/disabled until added.
# Google Places API — for /api/restaurants/nearby (nearby halal restaurant search)
GOOGLE_PLACES_API_KEY=
# Spoonacular API — for richer recipe data in the meal planner
SPOONACULAR_API_KEY=

NODE_ENV=production
